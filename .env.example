# ── Supabase (base partagée du réseau — clé ANON uniquement, RLS lecture seule) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Site ──
# URL canonique de production (sans slash final)
NEXT_PUBLIC_SITE_URL=https://exemple.fr
# false tant que le site n'est pas prêt à être indexé (robots.txt bloque tout + meta noindex)
NEXT_PUBLIC_INDEXABLE=false

# ── Revalidation (appelée par le SEO Dashboard à la publication) ──
# Doit correspondre à site_profiles.revalidate_secret ; revalidate_url = <NEXT_PUBLIC_SITE_URL>/api/revalidate
REVALIDATE_SECRET=changer-moi
